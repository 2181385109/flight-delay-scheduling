# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Data (regenerated from the synthetic generator) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.parquet
*.csv
!tests/**/*.csv

# --- Model artifacts (regenerated by `flightopt train`) ---
outputs/models/*
!outputs/models/.gitkeep

# --- Large figures / animations (keep small PNGs, drop heavy media) ---
outputs/figures/*.mp4
outputs/figures/*.gif

# --- Editors / OS / secrets ---
.env
.idea/
.vscode/
.DS_Store
Thumbs.db
